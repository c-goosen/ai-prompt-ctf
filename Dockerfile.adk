# Dockerfile for ADK API Server
# Both stages use the slim image: every locked dependency ships a cp314 wheel,
# so nothing needs compiling. If a new dependency only has an sdist, switch the
# builder to the full `-trixie` image (buildpack-deps) to get a toolchain.
# https://docs.astral.sh/uv/guides/integration/docker/

FROM ghcr.io/astral-sh/uv:0.11.21-python3.14-trixie-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

# Dependencies first for better layer caching
COPY uv.lock pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project

COPY . /app
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen

FROM ghcr.io/astral-sh/uv:0.11.21-python3.14-trixie-slim AS production

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    UV_NO_DEV=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

EXPOSE 8000/tcp

# Pre-create the HF cache so the hf_cache volume is initialised owned by appuser.
RUN groupadd -g 1500 appuser && \
    useradd -m -u 1500 -g appuser appuser && \
    install -d -o appuser -g appuser /home/appuser/.cache/huggingface

WORKDIR /app

# No --chown on the venv: it is read-only at runtime, so leaving it root-owned
# avoids a slow per-file ownership rewrite of the whole tree during COPY.
COPY --from=builder /app/.venv /app/.venv
COPY --chown=appuser:appuser . /app
# Owned by appuser so the lancedb_data volume is initialised writable.
RUN install -d -o appuser -g appuser /app/ctf/lancedb

USER appuser
WORKDIR /app/ctf/agents

ENTRYPOINT []
# Seed flags / download guard models (ctf/agent_startup.py), then serve.
CMD ["sh", "-c", "python -m ctf.agent_startup && exec adk web --host 0.0.0.0 --port 8000"]
