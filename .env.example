# Compose profile: default (Ollama in Docker) or prod (remote Ollama / API LLM)
COMPOSE_PROFILES=default

# --- default profile (optional overrides) ---
# OLLAMA_MODEL=qwen3:0.6b
# OPENSOURCE_LLM_MODEL=qwen3:0.6b

# --- prod profile: use with COMPOSE_PROFILES=prod ---
# Remote Ollama on the host (Linux: host.docker.internal is mapped in adk-api)
# OLLAMA_API_BASE=http://host.docker.internal:11434
# OPENSOURCE_LLM_MODEL=qwen3:0.6b

# API-based LLM (Gemini via Google ADK)
# USE_GEMINI=1
# GEMINI_MODEL_NAME=gemini-2.5-flash-lite

# API-based LLM (OpenAI via LiteLLM — set model to openai/<name> in OPENSOURCE_LLM_MODEL)
# OPENAI_API_KEY=sk-...
# OPENSOURCE_LLM_MODEL=openai/gpt-4o-mini

# --- Shared by the agent (adk-api) and the web app ---
# Level passwords: the agent checks them, the web app redacts them from RAG tool output.
# PASSWORD_ZERO=PASS_ZERO
# PASSWORD_ONE=PASS_ONE
# ... through PASSWORD_TEN
# Leaderboard database (compose builds POSTGRES_DB_URI from these)
# POSTGRES_USER=ctf
# POSTGRES_PASSWORD=ctf
# POSTGRES_DB=ctf

# --- Agent start-up (ctf/agent_startup.py) ---
# PREPARE_FLAGS=1       # seed level flags into LanceDB on start
# DOWNLOAD_MODELS=0     # skip pre-downloading the guard models

# --- Web app ---
# CTF_NAME=BSIDES CTF Prompt Injection challenge
# CTF_SUBTITLE=Agentic LLM CTF
# DISCORD_URL=https://discord.com/channels/...
# COOKIE_SECURE=1       # when served over HTTPS (compose defaults to 0 for http://localhost)
