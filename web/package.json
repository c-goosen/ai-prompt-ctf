{
  "name": "pwngpt-web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "predev": "pnpm content",
    "dev": "vite dev --port 3000",
    "prebuild": "pnpm content",
    "build": "vite build",
    "start": "node dist/standalone/server.js",
    "build:next": "pnpm content && next build",
    "lint": "eslint .",
    "typecheck": "pnpm content && tsc --noEmit",
    "test": "pnpm content && vitest run"
  },
  "dependencies": {
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "server-only": "0.0.1",
    "vinext": "1.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
