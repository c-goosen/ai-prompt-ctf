{
  "name": "pwngpt-web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "predev": "pnpm content",
    "dev": "vite dev --port 3000",
    "prebuild": "pnpm content",
    "build": "vite build",
    "start": "node dist/standalone/server.js",
    "build:next": "pnpm content && next build",
    "lint": "eslint .",
    "typecheck": "pnpm content && tsc --noEmit",
    "test": "pnpm content && vitest run",
    "dev:cf": "pnpm content && vite dev --config vite.config.cloudflare.ts --port 3001",
    "build:cf": "pnpm content && vite build --config vite.config.cloudflare.ts",
    "preview:cf": "wrangler dev --config dist/server/wrangler.json",
    "deploy:cf": "pnpm build:cf && vinext-cloudflare deploy --config dist/server/wrangler.json --skip-build"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.60.0",
    "motion": "14.5.0",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-server-dom-webpack": "19.3.1",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "vinext": "1.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vinext/cloudflare": "1.1.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
