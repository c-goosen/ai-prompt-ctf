# Dockerfile for Frontend (FastAPI)
# Builder uses the full trixie image (buildpack-deps) so packages like `regex`
# can compile when no cp314 wheel exists. Production stays slim.
# https://docs.astral.sh/uv/guides/integration/docker/

FROM ghcr.io/astral-sh/uv:0.11.21-python3.14-trixie AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

COPY uv.lock pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project

COPY . /app
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen

FROM ghcr.io/astral-sh/uv:0.11.21-python3.14-trixie-slim AS production

ENV FASTAPI_ENV=production \
    PYTHONUNBUFFERED=1 \
    UV_NO_DEV=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    CURL_CA_BUNDLE="" \
    REQUESTS_CA_BUNDLE=""

EXPOSE 8100/tcp

RUN groupadd -g 1500 appuser && \
    useradd -m -u 1500 -g appuser appuser

WORKDIR /app

COPY --from=builder --chown=appuser:appuser /app/.venv /app/.venv
COPY --chown=appuser:appuser . /app

USER appuser

ENTRYPOINT []
CMD ["uv", "run", "ctf/frontend/main.py"]
